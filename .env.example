# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,chaya-kada-244m.onrender.com

# Security Settings (SSL/HTTPS)
# For plain HTTP development/testing, set these to False
# For production HTTPS hosts, these default to True when DEBUG=False
ENABLE_SSL_REDIRECT=False
ENABLE_SECURE_COOKIES=False

# Database (Use DATABASE_URL on Render or individual settings locally)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Or use individual settings:
# DB_NAME=chayakada
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_HOST=localhost
# DB_PORT=5432

# Redis (Required for WebSocket/Channels support)
REDIS_URL=redis://localhost:6379
# On Render, add Redis service and use the internal Redis URL

# Cloudinary (Optional - for media storage)
# If not set, media files are stored locally
# CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
